# Legacy manual paths for check-bios.sh only. Prefer the native setup app.
# The app writes host selection to ~/Library/Application Support/Mac Game Console/setup.json.
STEAM_APPS_VDF="$HOME/Library/Application Support/Steam/steamapps/libraryfolders.vdf"
STEAM_COMMON_DEFAULT="$HOME/Library/Application Support/Steam/steamapps/common"
ROMS_ROOT="$HOME/Games/ROMs"
BIOS_ROOT="$HOME/Games/BIOS"
LIBRARY_INDEX_JSON="$ROOT_DIR/generated/library.json"
EMULATIONSTATION_APP="/Applications/ES-DE.app"
OPENEMU_APP="/Applications/OpenEmu.app"
RETROARCH_APP="/Applications/RetroArch.app"
